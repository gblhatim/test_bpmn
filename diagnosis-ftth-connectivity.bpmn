        <bpmndi:BPMNLabel>
          <dc:Bounds x="1288" y="664" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_DiagMerge" bpmnElement="GW_DiagMerge" isMarkerVisible="true">
        <dc:Bounds x="1110" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_CustomerPresent" bpmnElement="GW_CustomerPresent" isMarkerVisible="true">
        <dc:Bounds x="1300" y="225" width="50" height="50" />
