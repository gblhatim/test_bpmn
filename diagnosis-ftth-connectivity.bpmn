<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_diagnosis_ftth_connectivity" targetNamespace="http://bouyguestelecom.fr/bdm" exporter="Camunda Modeler" exporterVersion="5.41.0">
  <bpmn:error id="Err_LineTechUnavailable" name="SI technique indisponible" errorCode="ERR_LINE_TECH_UNAVAILABLE" />
  <bpmn:process id="diagnosis-ftth-connectivity" name="L3 - Diagnostic connectivite FTTH" isExecutable="true" camunda:versionTag="1.0.0" camunda:historyTimeToLive="180">
    <bpmn:documentation>NIVEAU L3 - Logique de flux. Aiguillage par categorie de panne vers les sous-diagnostics. La classification est en DMN, pas en passerelles imbriquees.
Agnostique au canal : la variable 'customerPresent' porte a elle seule la difference entre un diagnostic avec client en ligne et un diagnostic sur ticket.</bpmn:documentation>
    <bpmn:startEvent id="Start_Diag">
      <bpmn:outgoing>F_d01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_FetchLinedsqdq" name="Lire l&#39;etat de la ligne" camunda:asyncBefore="true" camunda:type="external" camunda:topic="ftth.line.status">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>F_d01</bpmn:incoming>
      <bpmn:outgoing>F_d02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_TechUnavailable" name="Diagnostic impossible (SI)" />
    <bpmn:exclusiveGateway id="GW_FaultCat" name="Categorie de panne ?">
      <bpmn:incoming>F_d02</bpmn:incoming>
      <bpmn:outgoing>F_d05</bpmn:outgoing>
      <bpmn:outgoing>F_d06</bpmn:outgoing>
      <bpmn:outgoing>F_d07</bpmn:outgoing>
      <bpmn:outgoing>F_d08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CA_Optical" name="Diagnostic optique" calledElement="diagnosis-optical" camunda:calledElementBinding="deployment">
      <bpmn:extensionElements>
        <camunda:in source="lineId" target="lineId" />
        <camunda:in source="customerPresent" target="customerPresent" />
        <camunda:out source="rootCauseFound" target="rootCauseFound" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_d05</bpmn:incoming>
      <bpmn:outgoing>F_d09</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="CA_Ont" name="Diagnostic ONT" calledElement="diagnosis-ont" camunda:calledElementBinding="deployment">
      <bpmn:extensionElements>
        <camunda:in source="lineId" target="lineId" />
        <camunda:in source="ontSerial" target="ontSerial" />
        <camunda:in source="customerPresent" target="customerPresent" />
        <camunda:out source="rootCauseFound" target="rootCauseFound" />
        <camunda:out source="ontOutcome" target="ontOutcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_d06</bpmn:incoming>
      <bpmn:outgoing>F_d10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="ST_CheckOutage" name="Interroger le registre des pannes" camunda:asyncBefore="true" camunda:type="external" camunda:topic="network.outage.lookup">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>F_d08</bpmn:incoming>
      <bpmn:outgoing>F_d12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_KnownOutage" name="Panne connue ?">
      <bpmn:incoming>F_d12</bpmn:incoming>
      <bpmn:outgoing>F_d13</bpmn:outgoing>
      <bpmn:outgoing>F_d14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_InformOutage" name="Informer le client de la panne" camunda:formKey="embedded:app:forms/inform-outage.html" camunda:candidateGroups="L1_FTTH">
      <bpmn:documentation>KB-FTTH-0088 - Communication panne collective
https://kb.internal/ftth/0088</bpmn:documentation>
      <bpmn:incoming>F_d13</bpmn:incoming>
      <bpmn:outgoing>F_d15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Outage" name="Panne collective">
      <bpmn:incoming>F_d15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Unresolved" name="Non resolu">
      <bpmn:incoming>F_d14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_DiagMerge">
      <bpmn:incoming>F_d09</bpmn:incoming>
      <bpmn:incoming>F_d10</bpmn:incoming>
      <bpmn:incoming>F_d07</bpmn:incoming>
      <bpmn:outgoing>F_d16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_CustomerPresent" name="Client en ligne ?">
      <bpmn:incoming>F_d16</bpmn:incoming>
      <bpmn:outgoing>F_d17</bpmn:outgoing>
      <bpmn:outgoing>F_d18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_ConfirmDiag" name="Confirmer le diagnostic au client" camunda:formKey="embedded:app:forms/confirm-diagnosis.html" camunda:candidateGroups="L1_FTTH">
      <bpmn:documentation>KB-FTTH-0150 - Restitution du diagnostic
https://kb.internal/ftth/0150</bpmn:documentation>
      <bpmn:incoming>F_d17</bpmn:incoming>
      <bpmn:outgoing>F_d19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_DiagEnd">
      <bpmn:incoming>F_d18</bpmn:incoming>
      <bpmn:incoming>F_d19</bpmn:incoming>
      <bpmn:outgoing>F_d20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Diagnosed" name="Diagnostic etabli">
      <bpmn:incoming>F_d20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_d01" sourceRef="Start_Diag" />
    <bpmn:sequenceFlow id="F_d02" targetRef="GW_FaultCat" />
    <bpmn:sequenceFlow id="F_d05" name="OPTICAL" sourceRef="GW_FaultCat" targetRef="CA_Optical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${faultCategory == 'OPTICAL'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d06" name="ONT" sourceRef="GW_FaultCat" targetRef="CA_Ont">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${faultCategory == 'ONT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d07" name="ROUTER" sourceRef="GW_FaultCat" targetRef="GW_DiagMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${faultCategory == 'ROUTER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d08" name="NETWORK" sourceRef="GW_FaultCat" targetRef="ST_CheckOutage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${faultCategory == 'NETWORK'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d09" sourceRef="CA_Optical" targetRef="GW_DiagMerge" />
    <bpmn:sequenceFlow id="F_d10" sourceRef="CA_Ont" targetRef="GW_DiagMerge" />
    <bpmn:sequenceFlow id="F_d12" sourceRef="ST_CheckOutage" targetRef="GW_KnownOutage" />
    <bpmn:sequenceFlow id="F_d13" name="oui" sourceRef="GW_KnownOutage" targetRef="UT_InformOutage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${knownOutage == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d14" name="non" sourceRef="GW_KnownOutage" targetRef="End_Unresolved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${knownOutage == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d15" sourceRef="UT_InformOutage" targetRef="End_Outage" />
    <bpmn:sequenceFlow id="F_d16" sourceRef="GW_DiagMerge" targetRef="GW_CustomerPresent" />
    <bpmn:sequenceFlow id="F_d17" name="oui" sourceRef="GW_CustomerPresent" targetRef="UT_ConfirmDiag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerPresent == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d18" name="non" sourceRef="GW_CustomerPresent" targetRef="GW_DiagEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerPresent == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_d19" sourceRef="UT_ConfirmDiag" targetRef="GW_DiagEnd" />
    <bpmn:sequenceFlow id="F_d20" sourceRef="GW_DiagEnd" targetRef="End_Diagnosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="diagnosis-ftth-connectivity">
      <bpmndi:BPMNShape id="Shape_Start_Diag" bpmnElement="Start_Diag">
