<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_diagnosis_ont"
                  targetNamespace="http://bouyguestelecom.fr/bdm"
                  exporter="BDM 2.0 generator" exporterVersion="1.0">
  <bpmn:error id="Err_TelemetryUnavailable" name="Telemetrie indisponible" errorCode="ERR_TELEMETRY_UNAVAILABLE" />
  <bpmn:process id="diagnosis-ont" name="L3 - Diagnostic ONT" isExecutable="true" camunda:versionTag="1.0.0" camunda:historyTimeToLive="180">
    <bpmn:documentation>NIVEAU L3. Sous-diagnostic appele par diagnosis-ftth-connectivity.
Les seuils de puissance optique sont en DMN (L5). Les scripts agent sont en base de connaissance (L4) : une user task = un ecran, pas une instruction.</bpmn:documentation>
    <bpmn:startEvent id="Start_Ont">
      <bpmn:outgoing>F_o01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_ReadTelemetry" name="Lire la telemetrie ONT" camunda:type="external" camunda:topic="ftth.ont.telemetry" camunda:asyncBefore="true">
      <bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R3/PT10S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements>
      <bpmn:incoming>F_o01</bpmn:incoming>
      <bpmn:outgoing>F_o02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BE_TelemetryError" name="Telemetrie KO" attachedToRef="ST_ReadTelemetry" cancelActivity="true">
      <bpmn:outgoing>F_o03</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_BE_TelemetryError" errorRef="Err_TelemetryUnavailable" camunda:errorCodeVariable="errorCode" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_TelemetryKo" name="Telemetrie indisponible">
      <bpmn:incoming>F_o03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="BR_EvalPower" name="Evaluer la puissance optique" camunda:decisionRef="ont-power-thresholds" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleEntry" camunda:resultVariable="ontPowerState">
      <bpmn:incoming>F_o02</bpmn:incoming>
      <bpmn:outgoing>F_o04</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_PowerState" name="Etat ONT ?">
      <bpmn:incoming>F_o04</bpmn:incoming>
      <bpmn:outgoing>F_o05</bpmn:outgoing>
      <bpmn:outgoing>F_o06</bpmn:outgoing>
      <bpmn:outgoing>F_o07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_CheckFiber" name="Faire verifier le connecteur fibre" camunda:formKey="embedded:app:forms/check-fiber.html" camunda:candidateGroups="L1_FTTH">
      <bpmn:documentation>KB-FTTH-0138 - Verification du connecteur fibre cote client
https://kb.internal/ftth/0138</bpmn:documentation>
      <bpmn:incoming>F_o05</bpmn:incoming>
      <bpmn:outgoing>F_o08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BE_FiberTimeout" name="Sans reponse 10 min" attachedToRef="UT_CheckFiber" cancelActivity="true">
      <bpmn:outgoing>F_o09</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_BE_FiberTimeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_NoResponse" name="Client injoignable">
      <bpmn:incoming>F_o09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_ReRead1" name="Relire la telemetrie" camunda:type="external" camunda:topic="ftth.ont.telemetry" camunda:asyncBefore="true" camunda:asyncAfter="true">
      <bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements>
      <bpmn:incoming>F_o08</bpmn:incoming>
      <bpmn:outgoing>F_o10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Resolved1" name="Signal retabli ?">
      <bpmn:incoming>F_o10</bpmn:incoming>
      <bpmn:outgoing>F_o11</bpmn:outgoing>
      <bpmn:outgoing>F_o12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_EscalateOptical" name="Escalade lien optique">
      <bpmn:incoming>F_o11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UT_PowerCycle" name="Guider le redemarrage ONT" camunda:formKey="embedded:app:forms/power-cycle.html" camunda:candidateGroups="L1_FTTH">
      <bpmn:documentation>KB-FTTH-0142 - Procedure de redemarrage ONT
https://kb.internal/ftth/0142</bpmn:documentation>
      <bpmn:incoming>F_o06</bpmn:incoming>
      <bpmn:outgoing>F_o13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="IE_WaitBoot" name="Attendre le demarrage">
      <bpmn:incoming>F_o13</bpmn:incoming>
      <bpmn:outgoing>F_o14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_IE_WaitBoot"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST_ReRead2" name="Relire la telemetrie" camunda:type="external" camunda:topic="ftth.ont.telemetry" camunda:asyncBefore="true" camunda:asyncAfter="true">
      <bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle></bpmn:extensionElements>
      <bpmn:incoming>F_o14</bpmn:incoming>
      <bpmn:outgoing>F_o15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Up" name="ONT remonte ?">
      <bpmn:incoming>F_o15</bpmn:incoming>
      <bpmn:outgoing>F_o16</bpmn:outgoing>
      <bpmn:outgoing>F_o17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_EscalateHw" name="Escalade materiel">
      <bpmn:incoming>F_o16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NotOnt" name="Cause hors ONT">
      <bpmn:incoming>F_o07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Resolved" name="Resolu">
      <bpmn:incoming>F_o18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_ResolvedMerge">
      <bpmn:incoming>F_o12</bpmn:incoming>
      <bpmn:incoming>F_o17</bpmn:incoming>
      <bpmn:outgoing>F_o18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_o01" sourceRef="Start_Ont" targetRef="ST_ReadTelemetry" />
    <bpmn:sequenceFlow id="F_o02" sourceRef="ST_ReadTelemetry" targetRef="BR_EvalPower" />
    <bpmn:sequenceFlow id="F_o03" sourceRef="BE_TelemetryError" targetRef="End_TelemetryKo" />
    <bpmn:sequenceFlow id="F_o04" sourceRef="BR_EvalPower" targetRef="GW_PowerState" />
    <bpmn:sequenceFlow id="F_o05" sourceRef="GW_PowerState" targetRef="UT_CheckFiber" name="POWER_LOW">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ontPowerState == 'POWER_LOW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_o06" sourceRef="GW_PowerState" targetRef="UT_PowerCycle" name="ONT_DOWN">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ontPowerState == 'ONT_DOWN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_o07" sourceRef="GW_PowerState" targetRef="End_NotOnt" name="ONT_OK">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ontPowerState == 'ONT_OK'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_o08" sourceRef="UT_CheckFiber" targetRef="ST_ReRead1" />
    <bpmn:sequenceFlow id="F_o09" sourceRef="BE_FiberTimeout" targetRef="End_NoResponse" />
    <bpmn:sequenceFlow id="F_o10" sourceRef="ST_ReRead1" targetRef="GW_Resolved1" />
    <bpmn:sequenceFlow id="F_o11" sourceRef="GW_Resolved1" targetRef="End_EscalateOptical" name="non">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ontUp == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_o12" sourceRef="GW_Resolved1" targetRef="GW_ResolvedMerge" name="oui">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ontUp == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_o13" sourceRef="UT_PowerCycle" targetRef="IE_WaitBoot" />
    <bpmn:sequenceFlow id="F_o14" sourceRef="IE_WaitBoot" targetRef="ST_ReRead2" />
    <bpmn:sequenceFlow id="F_o15" sourceRef="ST_ReRead2" targetRef="GW_Up" />
    <bpmn:sequenceFlow id="F_o16" sourceRef="GW_Up" targetRef="End_EscalateHw" name="non">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ontUp == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_o17" sourceRef="GW_Up" targetRef="GW_ResolvedMerge" name="oui">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ontUp == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_o18" sourceRef="GW_ResolvedMerge" targetRef="End_Resolved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
