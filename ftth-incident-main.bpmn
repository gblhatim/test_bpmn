          <dc:Bounds x="532" y="411" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Unreachable" bpmnElement="End_Unreachable">
        <dc:Bounds x="730" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="673" y="534" width="150" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_ChannelMerge" bpmnElement="GW_ChannelMerge" isMarkerVisible="true">
        <dc:Bounds x="730" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_Normalize" bpmnElement="CA_Normalize">
        <dc:Bounds x="920" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Qualified" bpmnElement="GW_Qualified" isMarkerVisible="true">
        <dc:Bounds x="1110" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1105" y="281" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Redirect" bpmnElement="End_Redirect">
        <dc:Bounds x="1300" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1264" y="144" width="108" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_Diagnosis" bpmnElement="CA_Diagnosis">
        <dc:Bounds x="1300" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_RootCause" bpmnElement="GW_RootCause" isMarkerVisible="true">
        <dc:Bounds x="1490" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1461" y="281" width="108" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_Resolution" bpmnElement="CA_Resolution">
        <dc:Bounds x="1680" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_Escalation" bpmnElement="CA_Escalation">
        <dc:Bounds x="1680" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_OutcomeMerge" bpmnElement="GW_OutcomeMerge" isMarkerVisible="true">
        <dc:Bounds x="1870" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CA_Closure" bpmnElement="CA_Closure">
        <dc:Bounds x="2060" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Done" bpmnElement="End_Done">
        <dc:Bounds x="2250" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2223" y="274" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F_m01" bpmnElement="F_m01">
        <di:waypoint x="196" y="380" />
