      <bpmndi:BPMNShape id="Shape_End_OptedOut" bpmnElement="End_OptedOut">
        <dc:Bounds x="730" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="703" y="144" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Attempts" bpmnElement="GW_Attempts" isMarkerVisible="true">
        <dc:Bounds x="730" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="689" y="281" width="132" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_MaxAttempts" bpmnElement="End_MaxAttempts">
        <dc:Bounds x="920" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="893" y="404" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BR_CallWindow" bpmnElement="BR_CallWindow">
        <dc:Bounds x="920" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_InWindow" bpmnElement="GW_InWindow" isMarkerVisible="true">
        <dc:Bounds x="1110" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1090" y="281" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_IE_WaitWindow" bpmnElement="IE_WaitWindow">
        <dc:Bounds x="1300" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1243" y="534" width="150" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ST_MarkReachable" bpmnElement="ST_MarkReachable">
        <dc:Bounds x="1300" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Reachable" bpmnElement="End_Reachable">
        <dc:Bounds x="1490" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1478" y="274" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F_c01" bpmnElement="F_c01">
        <di:waypoint x="196" y="250" />
        <di:waypoint x="350" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_c02" bpmnElement="F_c02">
        <di:waypoint x="450" y="250" />
        <di:waypoint x="540" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_c03" bpmnElement="F_c03">
        <di:waypoint x="590" y="250" />
        <di:waypoint x="660" y="250" />
        <di:waypoint x="660" y="120" />
        <di:waypoint x="730" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="96" width="40" height="14" />
