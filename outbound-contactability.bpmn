        <bpmndi:BPMNLabel>
          <dc:Bounds x="710" y="226" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_c05" bpmnElement="F_c05">
        <di:waypoint x="780" y="250" />
