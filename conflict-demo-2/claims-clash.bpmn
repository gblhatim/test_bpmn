<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Claims" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0">
  <bpmn:collaboration id="Collab_Claims">
    <bpmn:participant id="Part_Customer" name="Customer" />
    <bpmn:participant id="Part_Insurer" name="Insurer" processRef="Process_Claims" />
    <bpmn:messageFlow id="MF_Submit" name="Claim form" sourceRef="Part_Customer" targetRef="Start_Claim" />
    <bpmn:messageFlow id="MF_Notify" name="Payment notice" sourceRef="Task_Notify" targetRef="Part_Customer" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_ClaimSubmitted" name="ClaimSubmitted" />
  <bpmn:message id="Msg_BankConfirm" name="BankConfirmation" />
  <bpmn:message id="Msg_PaymentSettled" name="PaymentSettled" />
  <bpmn:message id="Msg_BankAck" name="BankAck" />
  <bpmn:error id="Err_Fraud" name="Fraud detected" errorCode="FRAUD" />
  <bpmn:process id="Process_Claims" name="Claims handling" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Claims">
      <bpmn:lane id="Lane_Intake" name="Intake">
        <bpmn:flowNodeRef>Start_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPolicy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Covered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assessment" name="Assessment">
        <bpmn:flowNodeRef>Sub_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FraudCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_Timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_FraudErr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ledger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Claim" name="Claim submitted">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start" messageRef="Msg_ClaimSubmitted" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Register" name="Register claim" camunda:assignee="intake-lead" camunda:formKey="embedded:app:forms/register.html">
      <bpmn:extensionElements><camunda:formData><camunda:formField id="claimId" label="Claim number" type="string" /><camunda:formField id="amount" label="Claim amount" type="long" /></camunda:formData><camunda:taskListener class="com.acme.claims.AssignListener" event="create" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Register</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_ClaimFile"><bpmn:targetRef>DOR_ClaimFile</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckPolicy" name="Check policy coverage" camunda:class="com.acme.claims.PolicyCheck" camunda:asyncBefore="true">
      <bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="policyNo">${policyNumber}</camunda:inputParameter><camunda:inputParameter name="region">EU</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements>
      <bpmn:incoming>Flow_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Check</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Covered" name="Covered?" default="Flow_NotCovered">
      <bpmn:incoming>Flow_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_NotCovered</bpmn:outgoing>
      <bpmn:outgoing>Flow_Covered</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Claim rejected">
      <bpmn:incoming>Flow_NotCovered</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_Reject" messageRef="Msg_ClaimSubmitted" />
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Assess" name="Assess damage">
      <bpmn:incoming>Flow_Covered</bpmn:incoming>
      <bpmn:outgoing>Flow_Assessed</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start" name="">
        <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Sub_Photos" name="Review photos" camunda:candidateGroups="assessors">
        <bpmn:incoming>Flow_S1</bpmn:incoming>
        <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="Sub_Estimate" name="Estimate repair cost" scriptFormat="javascript">
        <bpmn:incoming>Flow_S2</bpmn:incoming>
        <bpmn:outgoing>Flow_S3</bpmn:outgoing>
        <bpmn:script>execution.setVariable(&quot;estimate&quot;, amount * 0.9 - 100);</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="Sub_End" name="">
        <bpmn:incoming>Flow_S3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S1" sourceRef="Sub_Start" targetRef="Sub_Photos" />
      <bpmn:sequenceFlow id="Flow_S2" sourceRef="Sub_Photos" targetRef="Sub_Estimate" />
      <bpmn:sequenceFlow id="Flow_S3" sourceRef="Sub_Estimate" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Bnd_Timeout" name="48h without assessment" attachedToRef="Sub_Assess">
      <bpmn:outgoing>Flow_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timeout"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_Escalate" name="Escalate to supervisor" camunda:candidateGroups="supervisors">
      <bpmn:incoming>Flow_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalated</bpmn:outgoing>
      <bpmn:outgoing>Flow_EscalateFraud</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gw_Fraud" name="Fraud suspected?">
      <bpmn:incoming>Flow_Assessed</bpmn:incoming>
      <bpmn:incoming>Flow_Escalated</bpmn:incoming>
      <bpmn:outgoing>Flow_Suspicious</bpmn:outgoing>
      <bpmn:outgoing>Flow_Clear</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="Task_FraudCheck" name="Fraud scoring" camunda:decisionRef="fraudScore" camunda:resultVariable="fraudScore" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_Suspicious</bpmn:incoming>
      <bpmn:outgoing>Flow_Scored</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:boundaryEvent id="Bnd_FraudErr" name="Fraud" attachedToRef="Sub_Assess">
      <bpmn:outgoing>Flow_FraudErr</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_Fraud" errorRef="Err_Fraud" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Fraud" name="Fraud case opened">
      <bpmn:incoming>Flow_FraudErr</bpmn:incoming>
      <bpmn:incoming>Flow_EscalateFraud</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerED_Fraud" />
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gw_Split" name="">
      <bpmn:incoming>Flow_Clear</bpmn:incoming>
      <bpmn:incoming>Flow_Scored</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPayout</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToLedger</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Payout" name="Pay out" camunda:type="external" camunda:topic="payout">
      <bpmn:incoming>Flow_ToPayout</bpmn:incoming>
      <bpmn:outgoing>Flow_Paid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Ledger" name="Post to ledger" camunda:delegateExpression="${ledgerAdapterV2}">
      <bpmn:extensionElements><camunda:executionListener class="com.acme.claims.LedgerAudit" event="end" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ToLedger</bpmn:incoming>
      <bpmn:outgoing>Flow_Posted</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Gw_Join" name="">
      <bpmn:incoming>Flow_Paid</bpmn:incoming>
      <bpmn:incoming>Flow_Posted</bpmn:incoming>
      <bpmn:outgoing>Flow_Joined</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="Catch_Wait" name="24h cooling-off">
      <bpmn:incoming>Flow_Joined</bpmn:incoming>
      <bpmn:outgoing>Flow_Waited</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Wait"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Confirm" name="Bank confirmation">
      <bpmn:incoming>Flow_Waited</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Confirm" messageRef="Msg_BankAck" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_Notify" name="Notify customer" camunda:delegateExpression="${mailerV2}">
      <bpmn:incoming>Flow_Confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_Done</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Paid" name="Claim paid">
      <bpmn:incoming>Flow_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Claim" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_Register" sourceRef="Task_Register" targetRef="Task_CheckPolicy" />
    <bpmn:sequenceFlow id="Flow_Check" sourceRef="Task_CheckPolicy" targetRef="Gw_Covered" />
    <bpmn:sequenceFlow id="Flow_NotCovered" name="Not covered" sourceRef="Gw_Covered" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Covered" name="Covered" sourceRef="Gw_Covered" targetRef="Sub_Assess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${covered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Assessed" sourceRef="Sub_Assess" targetRef="Gw_Fraud" />
    <bpmn:sequenceFlow id="Flow_Timeout" sourceRef="Bnd_Timeout" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_Escalated" sourceRef="Task_Escalate" targetRef="Gw_Fraud" />
    <bpmn:sequenceFlow id="Flow_Suspicious" name="Yes" sourceRef="Gw_Fraud" targetRef="Task_FraudCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fraudScore &gt; 50}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Clear" name="No" sourceRef="Gw_Fraud" targetRef="Gw_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!suspicious}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Scored" sourceRef="Task_FraudCheck" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="Flow_FraudErr" sourceRef="Bnd_FraudErr" targetRef="End_Fraud" />
    <bpmn:sequenceFlow id="Flow_ToPayout" sourceRef="Gw_Split" targetRef="Task_Payout" />
    <bpmn:sequenceFlow id="Flow_ToLedger" sourceRef="Gw_Split" targetRef="Task_Ledger" />
    <bpmn:sequenceFlow id="Flow_Paid" sourceRef="Task_Payout" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_Posted" sourceRef="Task_Ledger" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_Joined" sourceRef="Gw_Join" targetRef="Catch_Wait" />
    <bpmn:sequenceFlow id="Flow_Waited" sourceRef="Catch_Wait" targetRef="Catch_Confirm" />
    <bpmn:sequenceFlow id="Flow_Confirmed" sourceRef="Catch_Confirm" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_Done" sourceRef="Task_Notify" targetRef="End_Paid" />
    <bpmn:sequenceFlow id="Flow_EscalateFraud" sourceRef="Task_Escalate" targetRef="End_Fraud" />
    <bpmn:dataObjectReference id="DOR_ClaimFile" name="Claim file" dataObjectRef="DO_ClaimFile" />
    <bpmn:dataObject id="DO_ClaimFile" />
    <bpmn:textAnnotation id="Ann_SLA"><bpmn:text>SLA: register within 1 working day</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_SLA" associationDirection="None" sourceRef="Task_Register" targetRef="Ann_SLA" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Claims"><bpmndi:BPMNPlane id="Plane_Claims" bpmnElement="Collab_Claims">
    <bpmndi:BPMNShape id="Part_Customer_di" bpmnElement="Part_Customer" isHorizontal="true"><dc:Bounds x="100" y="20" width="2200" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Part_Insurer_di" bpmnElement="Part_Insurer" isHorizontal="true"><dc:Bounds x="100" y="130" width="2200" height="890" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Intake_di" bpmnElement="Lane_Intake" isHorizontal="true"><dc:Bounds x="130" y="130" width="2170" height="260" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Assessment_di" bpmnElement="Lane_Assessment" isHorizontal="true"><dc:Bounds x="130" y="390" width="2170" height="330" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true"><dc:Bounds x="130" y="720" width="2170" height="300" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_Claim_di" bpmnElement="Start_Claim"><dc:Bounds x="200" y="242" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register"><dc:Bounds x="300" y="220" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_CheckPolicy_di" bpmnElement="Task_CheckPolicy"><dc:Bounds x="480" y="220" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gw_Covered_di" bpmnElement="Gw_Covered" isMarkerVisible="true"><dc:Bounds x="650" y="235" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected"><dc:Bounds x="760" y="162" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sub_Assess_di" bpmnElement="Sub_Assess" isExpanded="true"><dc:Bounds x="640" y="420" width="520" height="200" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sub_Start_di" bpmnElement="Sub_Start"><dc:Bounds x="670" y="502" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sub_Photos_di" bpmnElement="Sub_Photos"><dc:Bounds x="740" y="480" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sub_Estimate_di" bpmnElement="Sub_Estimate"><dc:Bounds x="900" y="480" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Sub_End_di" bpmnElement="Sub_End"><dc:Bounds x="1080" y="502" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Bnd_Timeout_di" bpmnElement="Bnd_Timeout"><dc:Bounds x="882" y="602" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate"><dc:Bounds x="1000" y="630" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gw_Fraud_di" bpmnElement="Gw_Fraud"><dc:Bounds x="1220" y="495" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_FraudCheck_di" bpmnElement="Task_FraudCheck"><dc:Bounds x="1320" y="410" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Bnd_FraudErr_di" bpmnElement="Bnd_FraudErr"><dc:Bounds x="1022" y="402" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_Fraud_di" bpmnElement="End_Fraud"><dc:Bounds x="1480" y="642" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gw_Split_di" bpmnElement="Gw_Split"><dc:Bounds x="1460" y="845" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Payout_di" bpmnElement="Task_Payout"><dc:Bounds x="1540" y="720" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Ledger_di" bpmnElement="Task_Ledger"><dc:Bounds x="1560" y="900" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gw_Join_di" bpmnElement="Gw_Join"><dc:Bounds x="1720" y="845" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Catch_Wait_di" bpmnElement="Catch_Wait"><dc:Bounds x="1810" y="852" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Catch_Confirm_di" bpmnElement="Catch_Confirm"><dc:Bounds x="1900" y="852" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify"><dc:Bounds x="1990" y="830" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_Paid_di" bpmnElement="End_Paid"><dc:Bounds x="2150" y="852" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="DOR_ClaimFile_di" bpmnElement="DOR_ClaimFile"><dc:Bounds x="332" y="330" width="36" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Ann_SLA_di" bpmnElement="Ann_SLA"><dc:Bounds x="300" y="145" width="120" height="40" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start"><di:waypoint x="236" y="260" /><di:waypoint x="300" y="260" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Register_di" bpmnElement="Flow_Register"><di:waypoint x="400" y="260" /><di:waypoint x="480" y="260" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Check_di" bpmnElement="Flow_Check"><di:waypoint x="580" y="260" /><di:waypoint x="650" y="260" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_NotCovered_di" bpmnElement="Flow_NotCovered"><di:waypoint x="700" y="260" /><di:waypoint x="730" y="260" /><di:waypoint x="730" y="180" /><di:waypoint x="760" y="180" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Covered_di" bpmnElement="Flow_Covered"><di:waypoint x="675" y="285" /><di:waypoint x="675" y="353" /><di:waypoint x="900" y="353" /><di:waypoint x="900" y="420" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1"><di:waypoint x="706" y="520" /><di:waypoint x="740" y="520" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_S2_di" bpmnElement="Flow_S2"><di:waypoint x="840" y="520" /><di:waypoint x="900" y="520" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_S3_di" bpmnElement="Flow_S3"><di:waypoint x="1000" y="520" /><di:waypoint x="1080" y="520" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Assessed_di" bpmnElement="Flow_Assessed"><di:waypoint x="1160" y="520" /><di:waypoint x="1220" y="520" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Timeout_di" bpmnElement="Flow_Timeout"><di:waypoint x="918" y="620" /><di:waypoint x="959" y="620" /><di:waypoint x="959" y="670" /><di:waypoint x="1000" y="670" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Escalated_di" bpmnElement="Flow_Escalated"><di:waypoint x="1100" y="670" /><di:waypoint x="1160" y="670" /><di:waypoint x="1160" y="520" /><di:waypoint x="1220" y="520" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Suspicious_di" bpmnElement="Flow_Suspicious"><di:waypoint x="1270" y="520" /><di:waypoint x="1295" y="520" /><di:waypoint x="1295" y="450" /><di:waypoint x="1320" y="450" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Clear_di" bpmnElement="Flow_Clear"><di:waypoint x="1270" y="520" /><di:waypoint x="1365" y="520" /><di:waypoint x="1365" y="870" /><di:waypoint x="1460" y="870" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_Scored_di" bpmnElement="Flow_Scored"><di:waypoint x="1420" y="450" /><di:waypoint x="1440" y="450" /><di:waypoint x="1440" y="870" /><di:waypoint x="1460" y="870" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_FraudErr_di" bpmnElement="Flow_FraudErr"><di:waypoint x="1058" y="420" /><di:waypoint x="1269" y="420" /><di:waypoint x="1269" y="660" /><di:waypoint x="1480" y="660" /></bpmndi:BPMNEdge>
